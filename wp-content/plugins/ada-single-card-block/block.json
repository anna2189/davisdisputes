{
  "apiVersion": 3,
  "name": "ada/single-card",
  "title": "Single Card",
  "category": "design",
  "icon": "index-card",
  "description": "A modern card container that can hold any WordPress blocks. Adjustable width so you can place 2–3 cards in a row.",
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "align": [
      "wide",
      "full"
    ],
    "layout": {
      "allowSwitching": true
    }
  },
  "attributes": {
    "badge": {
      "type": "string",
      "default": ""
    },
    "cardWidth": {
      "type": "string",
      "default": "auto"
    },
    "customWidth": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}